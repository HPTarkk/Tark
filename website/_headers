# Cloudflare static asset response headers.
#
# The app checks /update.json at launch. It already adds a cache-busting
# query, so this is for everything else in between — browsers, proxies, a
# future caller that forgets the query.
/update.json
  Cache-Control: no-cache, no-store, must-revalidate
  Access-Control-Allow-Origin: *

# The marketing site's release marker is independent of /update.json.
/site-version.json
  Cache-Control: no-cache, no-store, must-revalidate

# Android App Links verification. Google fetches this file directly and
# requires JSON with no redirect; say the type explicitly rather than rely
# on the extension mapping.
/.well-known/assetlinks.json
  Content-Type: application/json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

# The account-email fallback page (see _redirects and v/index.html). The
# token is in the URL fragment; these make sure nothing on the page could
# pass it on, and keep the page out of search results.
/v/*
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'none'; style-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Cache-Control: no-cache
