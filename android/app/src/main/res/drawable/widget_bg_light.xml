<?xml version="1.0" encoding="utf-8"?>
<!-- Widget card, light ("field radio") palette. See widget_bg_dark.xml. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#FFFDF7"
        android:endColor="#EFE8D8"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="#E0D5BD" />
    <corners android:radius="24dp" />
</shape>
