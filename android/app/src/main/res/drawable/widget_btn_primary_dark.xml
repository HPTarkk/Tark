<?xml version="1.0" encoding="utf-8"?>
<!-- Primary action pill, dark palette: amber -> amberDim, matching the app's
     accent buttons. See widget_bg_dark.xml for why this isn't values-night. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#F5853F"
        android:endColor="#D9661F"
        android:type="linear" />
    <corners android:radius="14dp" />
</shape>
