<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget card, dark ("night radio") palette. Hexes mirror AppPalette.dark in
    lib/core/theme/app_colors.dart — the widget follows the app's own theme
    setting rather than the system's, so this cannot be a values-night pair;
    TarkWidgetProvider picks between the _dark and _light drawables itself.

    The gradient runs card -> surface so the card reads as lit from the top
    left, matching the in-app surfaces.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#1A2027"
        android:endColor="#0F1317"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="#2D343D" />
    <corners android:radius="24dp" />
</shape>
