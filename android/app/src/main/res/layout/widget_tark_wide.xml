<?xml version="1.0" encoding="utf-8"?>
<!--
    Wide layout (roughly 4x2 and up): the full console — dial, callsign, live
    status, level strip, and the action row.

    Every color here is a placeholder. TarkWidgetProvider re-applies text
    colors and background resources at bind time from the palette the app
    published, because the widget follows the app's theme setting rather than
    the system's (so values-night would be wrong half the time).

    Type is Vazirmatn, the same family the app uses, via res/font — the
    platform default would otherwise render the widget in a different
    typeface from every screen it launches into, and has no Persian weights.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_dark"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_dial"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_marginEnd="13dp"
            android:contentDescription="@string/widget_dial_description" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Callsign + mode chip -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/widget_callsign"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/vazirmatn_bold"
                    android:letterSpacing="0.02"
                    android:textSize="15sp"
                    android:textColor="#E9EDF1"
                    android:text="@string/widget_app_name" />

                <TextView
                    android:id="@+id/widget_mode_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/widget_badge_dark"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:maxLines="1"
                    android:fontFamily="@font/vazirmatn_bold"
                    android:letterSpacing="0.12"
                    android:textSize="9sp"
                    android:textColor="#8B939D" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="@font/vazirmatn_extrabold"
                android:letterSpacing="0.04"
                android:textSize="16sp"
                android:textColor="#F5853F"
                android:text="@string/widget_status_placeholder" />

            <!--
                The one genuinely animated element. A widget can't run code,
                so nothing here is driven by the app — but ViewFlipper is a
                RemoteViews-supported class that cycles its children on its
                own, and cross-fading three phase-shifted level frames reads
                as a meter that's actually moving.

                When the session isn't live the provider sends the same frame
                three times, so the flip is invisible and the strip sits
                still rather than twitching for no reason.
            -->
            <ViewFlipper
                android:id="@+id/widget_wave_flipper"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:layout_marginTop="6dp"
                android:autoStart="true"
                android:flipInterval="600"
                android:inAnimation="@android:anim/fade_in"
                android:outAnimation="@android:anim/fade_out">

                <ImageView
                    android:id="@+id/widget_wave_0"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:contentDescription="@string/widget_level_description" />

                <ImageView
                    android:id="@+id/widget_wave_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:contentDescription="@string/widget_level_description" />

                <ImageView
                    android:id="@+id/widget_wave_2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:contentDescription="@string/widget_level_description" />
            </ViewFlipper>

            <TextView
                android:id="@+id/widget_peers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="@font/vazirmatn_medium"
                android:textSize="11sp"
                android:textColor="#8B939D" />
        </LinearLayout>
    </LinearLayout>

    <!-- Action row: the primary button is always present; mute/end appear
         only while a session is actually live (see the provider).

         46dp tall, close to Android's 48dp minimum touch target — the first
         version used 36dp pills, which were genuinely hard to hit. The dial
         above gave up the height for them. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_primary"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_primary_dark"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:fontFamily="@font/vazirmatn_extrabold"
            android:letterSpacing="0.10"
            android:textSize="12sp"
            android:textColor="#0B0E11"
            android:text="@string/widget_action_placeholder" />

        <TextView
            android:id="@+id/widget_mute"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_btn_ghost_dark"
            android:gravity="center"
            android:maxLines="1"
            android:minWidth="80dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:fontFamily="@font/vazirmatn_bold"
            android:letterSpacing="0.06"
            android:textSize="11sp"
            android:textColor="#E9EDF1"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_end"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_btn_danger_dark"
            android:gravity="center"
            android:maxLines="1"
            android:minWidth="70dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:fontFamily="@font/vazirmatn_bold"
            android:letterSpacing="0.06"
            android:textSize="11sp"
            android:textColor="#EF5350"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
