<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Voice-call audio mode + Bluetooth SCO routing for handsfree headsets. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Hotspot Bridge: creating a local-only Wi-Fi hotspot for iPhone↔Android.
         CHANGE_WIFI_STATE is required by startLocalOnlyHotspot; on Android 13+
         NEARBY_WIFI_DEVICES replaces the location requirement (neverForLocation
         since we only bring an AP up, never derive location). On API 26–32 the
         hotspot still needs ACCESS_FINE_LOCATION (declared below through 32). -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <!-- Joining the host's hotspot from inside the app: WifiNetworkSpecifier
         goes through ConnectivityManager.requestNetwork, and binding the
         process to that network is what stops Android from silently falling
         back to cellular once it notices the hotspot has no internet
         (see WifiJoinHandler). -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- Bluetooth Classic transport (Android). Legacy permissions are capped
         at API 30 by maxSdkVersion; API 31+ uses the runtime-requested
         BLUETOOTH_CONNECT/BLUETOOTH_SCAN below. neverForLocation is safe
         here since scan results are only used to list nearby device names,
         never to derive physical location. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- Android 6–11 gates ALL Bluetooth scanning (classic discovery and
         BLE) behind location — without these declared, scans silently find
         nothing there. From Android 12 the neverForLocation BLUETOOTH_SCAN
         above replaces them. FINE_LOCATION runs through API 32 (not 30) because
         the Hotspot Bridge's startLocalOnlyHotspot needs it on API 31–32;
         Android 13+ uses NEARBY_WIFI_DEVICES (above) instead. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="32" />
    <!-- Runs to 32 alongside FINE, not to 30: from Android 12 the system
         IGNORES a runtime request for ACCESS_FINE_LOCATION unless
         ACCESS_COARSE_LOCATION is requested in the same call, and an
         undeclared permission can never be part of it. Capping COARSE at 30
         therefore made the hotspot permission ungrantable on API 31-32 — the
         host failed every single time with "couldn't create the hotspot". -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <!-- BLE hosting (peripheral role) so iPhones can find and join us. -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />

    <!-- System-audio (music) sharing: MediaProjection playback capture must
         run inside a foreground service of type mediaProjection. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Screen-off keep-alive (motorcycle use case): a foreground service holds
         the CPU (WAKE_LOCK) and Wi-Fi awake so audio/UDP keep flowing while the
         screen is off. The session records the mic continuously, so the service
         is typed microphone (FOREGROUND_SERVICE_MICROPHONE, Android 14+).
         REQUEST_IGNORE_BATTERY_OPTIMIZATIONS lets the app prompt the user to
         whitelist it from Doze (essential on MIUI/Xiaomi). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- The hotspot host starts the keep-alive service before mic capture (while
         showing the QR), so that phase runs as a connectedDevice FGS instead of
         microphone. Qualified by CHANGE_WIFI_STATE (declared above). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <application
        android:label="تَرک"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- Two things here keep the app to exactly ONE instance, and both
             are needed:

             1. No android:taskAffinity="". It shipped in the original
                template; an empty affinity gives the activity a task the
                launcher's own MAIN intent can't match, so tapping the icon
                started a second instance instead of resuming.

             2. launchMode="singleTask", not "singleTop". singleTop only
                de-dupes when the activity is already at the top of the SAME
                task, which doesn't cover this app: the home-screen widget
                starts us with a custom action and a tark:// data URI, so the
                task it creates has a base intent that doesn't match
                ACTION_MAIN/CATEGORY_LAUNCHER — and Android then happily
                builds a second task when the icon is tapped. singleTask is
                what makes the instance unique regardless of which intent
                got there first; repeat launches arrive through onNewIntent.

             Getting this wrong is not cosmetic: a second instance builds a
             second FlutterEngine (a plain FlutterActivity owns and destroys
             its engine), which abandons the live session and detaches
             WidgetControlBridge, leaving the widget's MUTE/END with nothing
             to talk to.

             NOTE: changing affinity/launchMode does not rewrite task records
             that already exist. Duplicates created by an older build survive
             the update and have to be cleared once (force-stop, or swipe
             them out of Recents). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"
            />
            <!-- The home-screen widget launches us with a tark://widget/...
                 URI as the intent data. Flutter's automatic deep linking
                 would hand that straight to GoRouter as the initial route,
                 which has no such path and shows its error page — and it
                 overrides the start location main.dart already worked out.
                 The URI isn't a route: it's read out of the intent by
                 home_widget (see HomeWidgetService.takeInitialLaunch) and
                 turned into a destination there. The app declares no VIEW
                 intent-filters, so nothing else relies on this. -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="false"
            />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".audio.SystemAudioCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
        <service
            android:name=".keepalive.SessionKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="microphone|connectedDevice" />
        <!-- Notification access is the only way a third-party app can pause
             ANOTHER app's media session (see MediaControlHandler) — used so
             stopping music-cast can also stop the source app's local
             playback. We never read notification content; this service only
             needs to exist and be enabled by the user in system settings. -->
        <service
            android:name=".audio.TarkNotificationListenerService"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- Home-screen widget. Renders whatever the app last published (see
             lib/core/home_widget) and launches straight into the last-used
             mode; updatePeriodMillis is 0, so every redraw is app-pushed. -->
        <receiver
            android:name=".widget.TarkWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tark_widget_info" />
        </receiver>
        <!-- The widget's MUTE/END buttons. Not exported: the only sender is
             our own PendingIntent, and these control a live mic. -->
        <receiver
            android:name=".widget.TarkWidgetControlReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.b1101.tark.widget.TOGGLE_MUTE" />
                <action android:name="com.b1101.tark.widget.END_SESSION" />
            </intent-filter>
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>
</manifest>