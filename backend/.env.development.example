# Local development only. Generate real secrets with `go run ./cmd/tarkd keygen`
# and keep production values in the hosting platform's secret store.
TARK_ENV=development
TARK_DATABASE_URL=postgres://tark:tark@localhost:5432/tark?sslmode=disable
TARK_LINK_BASE_URL=https://tarkk.ir
TARK_MAIL_DRIVER=log
TARK_BAZAAR_FAKE=true
# Interactive API docs at /docs (on by default in development).
TARK_DOCS_ENABLED=true
# The Google OAuth "web" client id (public); the app sends it as serverClientId.
TARK_GOOGLE_CLIENT_IDS=632050243845-ntpm08ltt1uhmqd9401f5k2tjgb81l7h.apps.googleusercontent.com
# Paste the output of `go run ./cmd/tarkd keygen` below.
TARK_TOKEN_KEY=
TARK_LOOKUP_KEY=
TARK_DATA_KEY=
TARK_PASSWORD_PEPPER=
TARK_ENTITLEMENT_KEYS=
TARK_ENTITLEMENT_ACTIVE_KID=
