# Copy to .env.production on the server (deploy.ps1 -Init does this and fills in
# the generated secrets). NEVER commit the real file: it is git-ignored.
# Every TARK_* option is documented in backend/README.md ("Configuration").

# ---- you must fill these in -------------------------------------------------
TARK_DOMAIN=api.example.com
TARK_LINK_BASE_URL=https://example.com
# The Google OAuth "web" client id (public); the app sends it as serverClientId.
TARK_GOOGLE_CLIENT_IDS=632050243845-ntpm08ltt1uhmqd9401f5k2tjgb81l7h.apps.googleusercontent.com
TARK_MAIL_FROM=CHANGE_ME@example.com
TARK_SMTP_HOST=smtp.gmail.com
TARK_SMTP_PORT=587
TARK_SMTP_SECURITY=starttls
TARK_SMTP_USERNAME=CHANGE_ME
TARK_SMTP_PASSWORD=CHANGE_ME
TARK_BAZAAR_CLIENT_ID=CHANGE_ME
TARK_BAZAAR_CLIENT_SECRET=CHANGE_ME
TARK_BAZAAR_REFRESH_TOKEN=CHANGE_ME

# ---- generated by deploy.ps1 -Init (tarkd keygen); keep them safe -----------
# Losing TARK_DATA_KEY makes stored Bazaar tokens unreadable; changing
# TARK_TOKEN_KEY signs everyone out; changing TARK_PASSWORD_PEPPER locks every
# password account out. Back this file up somewhere private.
POSTGRES_PASSWORD=
TARK_TOKEN_KEY=
TARK_LOOKUP_KEY=
TARK_DATA_KEY=
TARK_PASSWORD_PEPPER=
TARK_ENTITLEMENT_KEYS=
TARK_ENTITLEMENT_ACTIVE_KID=

# ---- set by deploy.ps1 ------------------------------------------------------
TARK_ENV=production
TARK_IMAGE=

# ---- optional ---------------------------------------------------------------
# Serve the interactive API docs at /docs (off by default in production).
# TARK_DOCS_ENABLED=true
# Mirrors, if Docker Hub is unreachable from the server.
# TARK_POSTGRES_IMAGE=
# TARK_CADDY_IMAGE=
